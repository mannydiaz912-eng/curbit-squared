---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
---

<Layout
  title="Gallery | Curb-It² Lawn Mower Repair in Markham"
  description="See real lawn mower repair work from Curb-It² in East Markham, ON — rescued, restored, and returned to life."
  currentPath="/gallery/"
>
  <!-- PAGE HEADER -->
  <div class="page-header">
    <div class="container">
      <p class="section-label">Real Work. Real Results.</p>
      <h1>FROM THE <span>DRIVEWAY SHOP</span></h1>
      <p class="page-header-sub">
        Every mower tells a story. Here's some of the work we've rescued,
        repaired, and returned to life in Markham, ON.
      </p>
    </div>
  </div>

  <Gallery />

  <!-- BOTTOM CTA -->
  <div class="cta-strip">
    <div class="container cta-inner">
      <p>Have a mower that needs saving?</p>
      <div class="cta-actions">
        <a href="https://wa.me/14372308484" target="_blank" rel="noopener" class="btn btn-orange">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" style="width:1rem;height:1rem;flex-shrink:0;" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp / Text Us
        </a>
        <a href="/contact/" class="btn btn-outline">Book a Repair →</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-header { background: var(--black); padding: 4rem 0 3rem; color: white; }
  .page-header .section-label { color: var(--orange); margin-bottom: 0.5rem; }
  .page-header h1 { font-size: clamp(2.2rem, 5vw, 3.5rem); color: white; margin-bottom: 1rem; }
  .page-header h1 span { color: var(--orange); }
  .page-header-sub { color: rgba(255,255,255,0.8); font-size: 1.05rem; max-width: 520px; line-height: 1.6; }
  .cta-strip { background: var(--orange); padding: 2rem 0; }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .cta-strip p { font-family: 'Bebas Neue', sans-serif; font-size: 1.6rem; color: white; letter-spacing: 0.04em; }
  .cta-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .cta-strip .btn-orange { background: white; color: var(--orange); }
  .cta-strip .btn-outline { border-color: white; color: white; }
  .cta-strip .btn-outline:hover { background: white; color: var(--orange); }
  @media (max-width: 600px) {
    .cta-inner { flex-direction: column; text-align: center; }
    .cta-actions { justify-content: center; }
  }
</style>
