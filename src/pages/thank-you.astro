---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Thank You | Curb-It² Lawn Mower Repair Markham"
  description="Thanks for contacting Curb-It² — we'll be in touch shortly via WhatsApp or text."
  currentPath="/thank-you/"
>
  <div class="thankyou-wrap">
    <div class="container thankyou-inner">
      <div class="thankyou-icon">✅</div>
      <h1>Thanks for Reaching Out!</h1>
      <p>Our team will get back to you shortly via WhatsApp or text to discuss your repair.</p>
      <div class="thankyou-actions">
        <a href="/" class="btn btn-green">Back to Homepage →</a>
        <a href="/services/" class="btn btn-outline-green">View Our Services</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .thankyou-wrap {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    padding: 4rem 0;
  }

  .thankyou-inner {
    text-align: center;
    max-width: 560px;
  }

  .thankyou-icon {
    font-size: 4rem;
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    color: var(--green);
    margin-bottom: 1rem;
  }

  p {
    font-size: 1.1rem;
    color: #555;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .thankyou-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-outline-green {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 2rem;
    border-radius: 4px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.2rem;
    letter-spacing: 0.08em;
    border: 2px solid var(--green);
    color: var(--green);
    background: transparent;
    transition: background 0.2s, color 0.2s;
  }

  .btn-outline-green:hover {
    background: var(--green);
    color: white;
  }
</style>
