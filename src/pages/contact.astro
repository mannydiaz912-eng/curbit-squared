---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';
---

<Layout
  title="Contact Curb-It² | Book Lawn Mower Repair in Markham"
  description="WhatsApp, text, or fill out our form to book lawn mower repair in East Markham, ON. Weeknights & weekends by appointment. No fix, no charge."
  currentPath="/contact/"
>
  <!-- PAGE HEADER -->
  <div class="page-header">
    <div class="container">
      <p class="section-label">Get In Touch</p>
      <h1>BOOK YOUR <span>MOWER REPAIR</span></h1>
      <p class="page-header-sub">
        WhatsApp or text is our preferred way to connect — fastest response.
        Weeknights &amp; weekends by appointment in East Markham, ON.
      </p>
      <div class="header-contact-strip">
        <a href="https://wa.me/14372308484" target="_blank" rel="noopener" class="header-contact-item wa">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" style="width:1.1rem;height:1.1rem;flex-shrink:0;" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          <span>WhatsApp / Text: <strong>437-230-8484</strong></span>
          <em>Preferred</em>
        </a>
        <a href="mailto:curbitsquared@gmail.com" class="header-contact-item email">
          ✉ <span>curbitsquared@gmail.com</span>
        </a>
      </div>
    </div>
  </div>

  <Contact />
</Layout>

<style>
  .page-header { background: var(--green); padding: 4rem 0 3rem; color: white; }
  .page-header .section-label { color: var(--orange); margin-bottom: 0.5rem; }
  .page-header h1 { font-size: clamp(2.2rem, 5vw, 3.5rem); color: white; margin-bottom: 1rem; }
  .page-header h1 span { color: var(--orange); }
  .page-header-sub { color: rgba(255,255,255,0.85); font-size: 1.05rem; max-width: 560px; line-height: 1.6; margin-bottom: 1.75rem; }

  .header-contact-strip {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .header-contact-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1.25rem;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.15s;
  }

  .header-contact-item:hover { transform: translateY(-2px); }

  .header-contact-item.wa {
    background: #25D366;
    color: white;
  }

  .header-contact-item.wa em {
    font-style: normal;
    font-size: 0.75rem;
    background: rgba(255,255,255,0.25);
    padding: 0.1rem 0.4rem;
    border-radius: 100px;
    margin-left: 0.25rem;
  }

  .header-contact-item.email {
    background: rgba(255,255,255,0.15);
    color: white;
    border: 1px solid rgba(255,255,255,0.3);
  }

  @media (max-width: 600px) {
    .header-contact-strip { flex-direction: column; }
  }
</style>
