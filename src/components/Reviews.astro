---
const reviews = [
  {
    name: "Sarah M.",
    location: "Markham, ON",
    rating: 5,
    date: "April 2025",
    text: "Josh fixed my Honda mower that two other shops said was done. Had it running like new in 2 days. Honest pricing and exactly as promised — no fix, no charge. Will 100% be back.",
    service: "Full Tune-Up & Carburetor Clean",
  },
  {
    name: "David K.",
    location: "Scarborough, ON",
    rating: 5,
    date: "May 2025",
    text: "Brought in my Craftsman that wouldn't start after sitting all winter. Quick diagnosis, same-week turnaround. Really fair price. Great father and son team — you can tell they actually care about the work.",
    service: "Fuel System & Spark Plug Service",
  },
  {
    name: "Linda T.",
    location: "Pickering, ON",
    rating: 5,
    date: "May 2025",
    text: "I was about to throw my mower out. A neighbour recommended Curb-It² and I'm so glad they did. Fixed and back in my hands within days. Saved me hundreds vs buying new. Highly recommend!",
    service: "Small Engine Repair & Blade Sharpening",
  },
];
---

<section class="reviews" id="reviews">
  <div class="container">
    <div class="reviews-header">
      <p class="section-label">What Customers Say</p>
      <h2 class="section-title">GOOGLE <span>REVIEWS</span></h2>
      <div class="rating-summary">
        <div class="stars-big">★★★★★</div>
        <div class="rating-text">
          <strong>5.0</strong> out of 5
          <span>&nbsp;· Google Reviews</span>
        </div>
      </div>
    </div>

    <div class="reviews-grid">
      {reviews.map((r) => (
        <div class="review-card">
          <div class="review-top">
            <div class="reviewer-info">
              <div class="reviewer-avatar">{r.name.charAt(0)}</div>
              <div>
                <strong class="reviewer-name">{r.name}</strong>
                <span class="reviewer-location">{r.location}</span>
              </div>
            </div>
            <div class="google-icon">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-label="Google">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
              </svg>
            </div>
          </div>

          <div class="review-stars">★★★★★</div>

          <p class="review-text">"{r.text}"</p>

          <div class="review-footer">
            <span class="review-service">🔧 {r.service}</span>
            <span class="review-date">{r.date}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="reviews-cta">
      <a href="https://www.google.com/search?q=Curb-It+Squared+Markham" target="_blank" rel="noopener" class="btn-google">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="18" height="18">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        View All Google Reviews ↗
      </a>
    </div>
  </div>
</section>

<style>
  .reviews { background: white; padding: 5rem 0; }

  .reviews-header { text-align: center; margin-bottom: 3rem; }

  .rating-summary {
    display: flex; align-items: center; justify-content: center;
    gap: 0.75rem; margin-top: 0.75rem;
  }

  .stars-big { color: #FBBC05; font-size: 1.6rem; letter-spacing: 2px; }

  .rating-text { font-size: 1rem; color: #555; }
  .rating-text strong { font-size: 1.3rem; color: var(--black); }
  .rating-text span { color: #888; font-size: 0.9rem; }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .review-card {
    background: var(--bg);
    border-radius: 8px;
    padding: 1.75rem;
    border: 1px solid #e8e8e8;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .review-card:hover {
    box-shadow: 0 6px 24px rgba(11,107,58,0.1);
    transform: translateY(-3px);
  }

  .review-top {
    display: flex; align-items: center;
    justify-content: space-between; margin-bottom: 0.75rem;
  }

  .reviewer-info { display: flex; align-items: center; gap: 0.75rem; }

  .reviewer-avatar {
    width: 42px; height: 42px; border-radius: 50%;
    background: var(--green); color: white;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem;
    flex-shrink: 0;
  }

  .reviewer-name { display: block; font-weight: 800; font-size: 0.95rem; }
  .reviewer-location { display: block; font-size: 0.8rem; color: #777; }

  .review-stars { color: #FBBC05; font-size: 1.1rem; letter-spacing: 1px; margin-bottom: 0.75rem; }

  .review-text {
    font-size: 0.93rem; color: #444; line-height: 1.7;
    margin-bottom: 1.25rem; font-style: italic;
  }

  .review-footer {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 0.5rem;
    border-top: 1px solid #e8e8e8; padding-top: 0.75rem;
  }

  .review-service { font-size: 0.78rem; font-weight: 700; color: var(--green); }
  .review-date { font-size: 0.78rem; color: #999; }

  .reviews-cta { text-align: center; }

  .btn-google {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.8rem 1.75rem;
    border: 2px solid #e0e0e0; border-radius: 4px;
    font-family: 'Nunito', sans-serif; font-weight: 700; font-size: 0.95rem;
    color: var(--black); background: white;
    transition: border-color 0.2s, box-shadow 0.2s;
    text-decoration: none;
  }

  .btn-google:hover {
    border-color: #4285F4;
    box-shadow: 0 2px 12px rgba(66,133,244,0.15);
  }

  @media (max-width: 600px) {
    .reviews-grid { grid-template-columns: 1fr; }
  }
</style>
