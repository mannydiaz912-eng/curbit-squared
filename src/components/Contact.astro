---
---
<section class="contact" id="contact">
  <div class="container">
    <div class="contact-grid">
      <!-- Info Side -->
      <div class="contact-info">
        <p class="section-label">Get In Touch</p>
        <h2 class="section-title">BOOK YOUR<br/> <span>MOWER REPAIR</span></h2>
        <p class="contact-sub">
          WhatsApp or text is our preferred way to connect — it's the fastest way to reach us
          and get a quick response. We work weeknights and weekends by appointment.
        </p>

        <div class="contact-details">
          <a href="https://wa.me/14372308484" target="_blank" rel="noopener" class="contact-item contact-item--whatsapp">
            <span class="ci-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="wa-icon" aria-label="WhatsApp">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </span>
            <div>
              <strong>WhatsApp / Text</strong>
              <span>437-230-8484</span>
              <em>Preferred — fastest response</em>
            </div>
          </a>
          <a href="mailto:curbitsquared@gmail.com" class="contact-item">
            <span class="ci-icon">✉️</span>
            <div>
              <strong>Email Us</strong>
              <span>curbitsquared@gmail.com</span>
            </div>
          </a>
          <div class="contact-item">
            <span class="ci-icon">📍</span>
            <div>
              <strong>Location</strong>
              <span>East Markham, Ontario</span>
            </div>
          </div>
          <div class="contact-item">
            <span class="ci-icon">🕐</span>
            <div>
              <strong>Hours</strong>
              <span>Weeknights &amp; Weekends — By Appointment</span>
            </div>
          </div>
        </div>

        <div class="guarantee-box">
          <span class="guarantee-icon">🛡️</span>
          <div>
            <strong>Our Guarantee</strong>
            <p>If we don't fix your mower, you pay absolutely nothing. That's our promise.</p>
          </div>
        </div>
      </div>

      <!-- Form Side -->
      <div class="contact-form-wrap">
        <h3>Send Us a Message</h3>
        <p class="form-sub">Fill out the form and we'll reach back out via WhatsApp or text.</p>

        <form
          class="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
        >
          <input type="hidden" name="access_key" value="60f0c707-9e99-4d82-96c0-b36b6769670e" />
          <input type="hidden" name="subject" value="New Repair Request - Curb-It²" />
          <input type="hidden" name="redirect" value="https://curbitsquared.com/thank-you/" />
          <input type="checkbox" name="botcheck" style="display:none" />

          <div class="form-row">
            <div class="form-group">
              <label for="name">Your Name *</label>
              <input type="text" id="name" name="name" placeholder="John Smith" required />
            </div>
            <div class="form-group">
              <label for="phone">Phone / WhatsApp *</label>
              <input type="tel" id="phone" name="phone" placeholder="416-555-0100" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="city">Your City *</label>
              <input type="text" id="city" name="city" placeholder="e.g. Markham, Scarborough, Pickering" required />
            </div>
            <div class="form-group">
              <label for="mower">Mower Make &amp; Model</label>
              <input type="text" id="mower" name="mower" placeholder="e.g. Honda HRX217, Craftsman M230" />
            </div>
          </div>

          <div class="form-group">
            <label for="issue">Describe the Issue *</label>
            <textarea id="issue" name="issue" rows="4" placeholder="Won't start, rough idle, blades won't engage..." required></textarea>
          </div>

          <div class="form-group">
            <label for="pickup">Pickup &amp; Delivery?</label>
            <select id="pickup" name="pickup">
              <option value="dropoff">I'll drop it off</option>
              <option value="pickup">Yes, please pick it up (East Markham)</option>
            </select>
          </div>

          <button type="submit" class="btn btn-orange form-submit">Send Repair Request →</button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--bg);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 5rem;
    align-items: start;
  }

  .contact-sub {
    color: #555;
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: white;
    border-radius: 6px;
    border: 1px solid rgba(0,0,0,0.07);
    transition: border-color 0.2s;
    text-decoration: none;
    color: inherit;
  }

  .contact-item:hover { border-color: var(--green); }

  .contact-item--whatsapp {
    border-color: #25D366;
    background: #f0fdf4;
  }

  .contact-item--whatsapp:hover { border-color: #128C7E; background: #dcfce7; }

  .wa-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: #25D366;
    display: block;
  }

  .ci-icon { font-size: 1.5rem; flex-shrink: 0; }

  .contact-item strong {
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--green);
    font-weight: 800;
  }

  .contact-item span {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .contact-item em {
    display: block;
    font-size: 0.75rem;
    font-style: normal;
    color: #25D366;
    font-weight: 700;
    margin-top: 0.1rem;
  }

  .guarantee-box {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--green);
    color: white;
    border-radius: 6px;
    align-items: flex-start;
  }

  .guarantee-icon { font-size: 1.75rem; flex-shrink: 0; }

  .guarantee-box strong {
    display: block;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.3rem;
    letter-spacing: 0.04em;
    margin-bottom: 0.25rem;
  }

  .guarantee-box p { font-size: 0.9rem; opacity: 0.9; }

  /* Form */
  .contact-form-wrap {
    background: white;
    border-radius: 8px;
    padding: 2.5rem;
    box-shadow: var(--shadow);
  }

  .contact-form-wrap h3 {
    font-size: 1.8rem;
    color: var(--green);
    margin-bottom: 0.25rem;
  }

  .form-sub {
    color: #666;
    font-size: 0.9rem;
    margin-bottom: 1.75rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    margin-bottom: 1.1rem;
  }

  .form-group label {
    display: block;
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--black);
    margin-bottom: 0.35rem;
  }

  .form-group input,
  .form-group textarea,
  .form-group select {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: 2px solid #e0e0e0;
    border-radius: 4px;
    font-family: 'Nunito', sans-serif;
    font-size: 0.95rem;
    color: var(--black);
    background: #fafafa;
    transition: border-color 0.2s;
    outline: none;
    resize: vertical;
  }

  .form-group input:focus,
  .form-group textarea:focus,
  .form-group select:focus {
    border-color: var(--green);
    background: white;
  }

  .form-submit {
    width: 100%;
    justify-content: center;
    font-size: 1.15rem;
    padding: 1rem;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 500px) {
    .form-row { grid-template-columns: 1fr; }
    .contact-form-wrap { padding: 1.5rem; }
  }
</style>
